# Example only: NOT automatically loaded by run_windows.bat / server.py
# Set variables in your terminal/session before starting the server.
SMALLBIZ_DB=./demo.sqlite3
# Protect encrypted credentials by backing up both DB and key.
SMALLBIZ_KEY_FILE=./.smallbiz-fernet-key
# For remote Twilio webhooks and Voice audio delivery, requires public HTTPS.
SMALLBIZ_PUBLIC_BASE_URL=https://your-domain.example
# WARNING: Set to 1 only after consent, A2P compliance and testing.
SMALLBIZ_ENABLE_LIVE_SMS=0
# WhatsApp Graph API version; match a version enabled for your Meta app.
SMALLBIZ_META_GRAPH_API_VERSION=v25.0
# Optional, for HTTP localhost AI endpoints only.
SMALLBIZ_ALLOW_LOCAL_AI=0
